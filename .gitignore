# ============================================================
# .gitignore - End-to-End Kubernetes DevSecOps Tetris Project
# ============================================================

# --- Terraform ---
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
.terraform.lock.hcl
terraform.tfvars          # قد يحتوي على بيانات حساسة — استخدم variables.tfvars فقط
# Wave 4: filled backend configs (examples stay tracked as *.hcl.example).
terraform/**/backend.local.hcl
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
crash.log

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity

# --- React Build ---
build/
dist/
.cache/

# --- Test / coverage output (generated; never commit new files here) ---
# NOTE: Chess-Backend/coverage/ has tracked legacy files; the pattern below stops
# NEW files from being added. Untracking the legacy files is a Wave 1 cleanup item.
coverage/
*.lcov

# --- Environment & Secrets ---
# Wave 0: `.env.*` covers ALL dotenv variants (.env.test, .env.staging, .env.production, ...).
# Only the documented templates below may be committed.
.env
.env.*
!.env.example
!Chess-Backend/.env.example
*.pem
*.key
*.cert
*.p12
*.pfx
*.passphrase
*secret*
*credentials*
# Negations for non-secret paths that legitimately match the broad patterns above.
# (Parent dir must be re-included before its files. Note: everything under
# docs/security/ is committable by design; its guard is gitleaks + review, not gitignore.)
!docs/security/
!docs/security/**
# Wave 7: ESO manifests are secret DELIVERY wiring (remoteRefs only, no
# values — asserted by the static checkers) and MUST be tracked. Without
# these negations the broad *secret* pattern silently drops them from git.
!deploy/helm/chess/templates/externalsecrets.yaml
!deploy/helm/chess/templates/secretstore.yaml
!deploy/helm/chess-observability/templates/externalsecrets.yaml
!deploy/helm/chess-observability/templates/secretstore.yaml

# --- Docker ---
# .dockerignore files are intentionally tracked for reproducible, minimal contexts.

# --- Security Scan Reports (لا تُرفع للـ repo) ---
trivyfs.txt
trivyimage.txt
dependency-check-report.*
gitleaks-report.json
trivy-results.json

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*.suo
*.user
*.iml
.project
.classpath

# --- Logs ---
*.log
logs/

# --- Jenkins ---
.jenkins/

backups/
certs/
letsencrypt/
playwright-report/
test-results/
tests/certs/
# Wave 6: never commit bytecode
__pycache__/
*.pyc

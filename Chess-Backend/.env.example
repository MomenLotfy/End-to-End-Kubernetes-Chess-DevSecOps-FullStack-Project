NODE_ENV=production
PORT=5000
DB_HOST=chess-postgres
DB_PORT=5432
DB_NAME=chess_db
DB_USER=chess_user
DB_PASSWORD=replace-with-a-long-random-password
DB_SSL=false
# For an external TLS PostgreSQL server: DB_SSL=true and PEM contents with \n escapes:
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
JWT_SECRET=replace-with-at-least-32-cryptographically-random-characters
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=30
FRONTEND_URL=https://chess.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_FROM=Chess Security <no-reply@chess.example.com>
TRUST_PROXY_HOPS=1

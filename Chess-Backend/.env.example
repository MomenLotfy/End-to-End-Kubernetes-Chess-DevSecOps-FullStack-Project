# ============================================================
# Chess Backend — Environment Variables
# انسخ هذا الملف وأعد تسميته .env وعدّل القيم
# ============================================================

# Server
NODE_ENV=production
PORT=5000

# PostgreSQL
DB_HOST=chess-postgres
DB_PORT=5432
DB_NAME=chess_db
DB_USER=chess_user
DB_PASSWORD=chess_password_CHANGE_ME

# JWT
JWT_SECRET=chess-jwt-secret-CHANGE-ME-IN-PRODUCTION
JWT_EXPIRES=7d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

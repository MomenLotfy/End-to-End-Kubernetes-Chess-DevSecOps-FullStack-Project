{
  "title": "Chess Platform Overview",
  "uid": "chess-overview",
  "tags": ["chess", "staging"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Backend up",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job=\"backend\"}", "legendFormat": "backend" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } } ]}, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 2, "type": "stat", "title": "Frontend replicas available",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [{ "refId": "A", "expr": "kube_deployment_status_replicas_available{deployment=\"chess-frontend\",namespace=\"chess-staging\"}", "legendFormat": "available" }],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 3, "type": "stat", "title": "5xx ratio (5m)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [{ "refId": "A", "expr": "api:http_error_ratio5m", "legendFormat": "5xx ratio" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }, { "value": 0.01, "color": "yellow" }, { "value": 0.05, "color": "red" } ] }}, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 4, "type": "stat", "title": "API p95 (5m)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [{ "refId": "A", "expr": "api:http_latency_p95_5m", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 5, "type": "stat", "title": "Sockets active",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [{ "refId": "A", "expr": "socket_io_connections_active", "legendFormat": "sockets" }],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 6, "type": "stat", "title": "DB pool waiting",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [{ "refId": "A", "expr": "db_pool_connections{state=\"waiting\"}", "legendFormat": "waiting" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 3, "color": "red" } ] }}, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 7, "type": "timeseries", "title": "Request rate (rps)",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (status_class) (rate(http_requests_total[5m]))", "legendFormat": "status {{status_class}}" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Latency percentiles",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Pod restarts (1h increase)",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"chess-.*\"}[1h]))", "legendFormat": "restarts {{pod}}" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Container CPU (cores)",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"chess-.*\",container!=\"\"}[5m]))", "legendFormat": "cpu {{pod}}" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Container memory (working set)",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "chess-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"chess-.*\",container!=\"\"})", "legendFormat": "mem {{pod}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    }
  ]
}

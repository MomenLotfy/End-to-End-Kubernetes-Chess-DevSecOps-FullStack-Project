# Copy to backend.local.hcl (git-ignored) and fill in YOUR state bucket from
# the bootstrap step. Separate state key from staging.
#
#   cp backend.production.hcl.example backend.local.hcl

bucket       = "CHANGEME-chess-terraform-state"
key          = "chess/production/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true

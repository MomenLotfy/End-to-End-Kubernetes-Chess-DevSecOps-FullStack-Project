# Copy to terraform.tfvars (git-ignored) and fill in. DO NOT APPLY IN WAVE 4.
#
#   cp terraform.tfvars.example terraform.tfvars

aws_region = "us-east-1"

# REQUIRED: your IAM role/user ARN — receives EKS cluster-admin access entry.
cluster_admin_role_arn = "arn:aws:iam::123456789012:role/CHANGEME-admin"

# OPTIONAL: admin CIDRs for the EKS public API endpoint ([] = private-only).
#   eks_public_access_cidrs = ["203.0.113.10/32"]

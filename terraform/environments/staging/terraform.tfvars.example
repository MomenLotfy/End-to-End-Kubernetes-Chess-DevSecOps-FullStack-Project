# Copy to terraform.tfvars (git-ignored) and fill in. See terraform/README.md.
#
#   cp terraform.tfvars.example terraform.tfvars

aws_region = "us-east-1"

# REQUIRED: your IAM role/user ARN — receives EKS cluster-admin access entry.
cluster_admin_role_arn = "arn:aws:iam::123456789012:role/CHANGEME-admin"

# OPTIONAL: your public IP as /32 to reach the EKS API without VPN.
# Default [] keeps the endpoint private-only (recommended until you need kubectl).
#   eks_public_access_cidrs = ["203.0.113.10/32"]
